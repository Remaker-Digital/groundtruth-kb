# Default for every tracked text file: normalized to LF in the index and
# checked out as LF whatever core.autocrlf says. Without this the Windows
# checkout rewrites thousands of tracked files to CRLF, and git reports them
# as modified forever; 3,453 tracked files were in that state before this rule
# (owner decision, 2026-09-08). Binary types are declared rather than guessed.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.whl binary
*.db binary
*.sqlite binary
*.bundle binary
*.docx binary
*.xlsx binary
*.pptx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary

# Windows entry points keep CRLF: cmd.exe mis-parses multi-line batch files
# with LF-only endings. The projection-root rules below still win for the
# projector-written copies under the harness roots, which are LF by design.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

/.gitattributes text eol=lf
/.gitignore text eol=lf

*.json text eol=lf
*.toml text eol=lf

.codex/skills/** text eol=lf
.agent/skills/** text eol=lf
.api-harness/skills/** text eol=lf
.claude/skills/** text eol=lf
groundtruth-kb/templates/hooks/** text eol=lf
groundtruth-kb/templates/skills/** text eol=lf
.harness-baseline-configuration/hooks/** text eol=lf
.claude/hooks/** text eol=lf

# Harness projection roots are projector outputs written with LF; since owner
# ruling D14 (2026-09-17) they are gitignored and untracked, so a checkout
# carries none of them and these rules act only on a historical or force-added
# copy. The neutral baseline stays tracked and LF so the projector's inputs
# match byte for byte and `--check` stays green after checkout.
.claude/** text eol=lf
.goose/** text eol=lf
.codex/** text eol=lf
.cursor/** text eol=lf
.agent/** text eol=lf
.api-harness/** text eol=lf
.harness-baseline-configuration/** text eol=lf
# The one skills source (owner ruling D15/D34, 2026-09-19): tracked, LF, read
# in place by the hosts and by the projector's pointer-stub renderer.
.agents/** text eol=lf
