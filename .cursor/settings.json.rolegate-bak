{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level harness settings. This file is TRACKED in git (negated by .gitignore) so every worktree and fresh clone inherits the project-level hook configuration. Workstation-specific permissions live in settings.local.json which remains untracked. Note 2026-04-25: the OS Claude/Codex bridge pollers were halted by owner directive (token-cost regression); the poller-freshness UserPromptSubmit hook was removed in the same change. Bridge scans are now manual via owner 'Bridge' prompts.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/spec-before-code.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/kb-not-markdown.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/destructive-gate.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/credential-scan.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/scanner-safe-writer.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/formal-artifact-approval-gate.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/document_author_provenance_gate.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell|Delete|Move|Copy",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/workstream-focus.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/lo-file-safety-gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/implementation-start-gate.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell|Delete|Move|Copy",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/directive-enforcement-claude-adapter.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/bridge-compliance-gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/bridge-proposal-wi-id-collision-gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/narrative-artifact-approval-gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/code-quality-baseline-proposal-check.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/dispatch_blackbox_gate.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/sot-read-discipline.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/session-start-governance.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/assertion-check.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/session_start_dispatch.py\" --startup-service \"$CLAUDE_PROJECT_DIR/scripts/session_self_initialization.py\" --harness-name claude",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/assertion-check.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/delib-search-tracker.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/owner-decision-capture.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/spec-event-surfacer.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/spec-event-surfacer.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/owner-decision-capture.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/bridge_verified_backlog_reconciler.py\" --apply --quiet --project-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/bridge_verified_backlog_reconciler.py\" --apply --quiet --project-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/session_self_initialization.py\" --emit-wrapup --fast-hook --harness-name claude",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/owner-decision-tracker.py\" --mode stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/bridge_verified_backlog_reconciler.py\" --apply --quiet --project-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/advisory-router-scan.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/advisory_grilling_gate_lint.py\" --stop-hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/scripts/auto_finalize_sweep.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/workstream-focus.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/delib-search-gate.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/intake-classifier.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/gov09-capture.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/owner-decision-tracker.py\" --mode user-prompt-submit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/bridge-axis-2-surface.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/spec-classifier.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/glossary-expansion.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/project-completion-surface.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/session-topic-envelope-router.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/intake-classifier.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.cursor/hooks/gov09-capture.py\""
          }
        ]
      }
    ]
  }
}
