+def _write_live_launch_state(
+    root: Path,
+    *,
+    launch_ledger: dict[str, dict[str, object]] | None = None,
+    last_launch: dict[str, object] | None = None,
+    second_ledger: dict[str, dict[str, object]] | None = None,
+) -> str:
+    dispatch_id = "2026-06-23T10-00-00Z-prime-builder-A-live"
+    path = root / ".gtkb-state" / "bridge-poller" / "dispatch-state.json"
+    state = json.loads(path.read_text(encoding="utf-8"))
+    recipient = state["recipients"]["prime-builder:A"]
+    if launch_ledger is not None:
+        recipient["launch_ledger"] = launch_ledger
+    if last_launch is not None:
+        recipient["last_launch"] = last_launch
+    if second_ledger is not None:
+        state["recipients"]["loyal-opposition:D"]["launch_ledger"] = second_ledger
+    path.write_text(json.dumps(state), encoding="utf-8")
+    return dispatch_id
+
+
+def _compact_payload(root: Path, config: Path) -> dict[str, object]:
+    result = CliRunner().invoke(
+        main,
+        ["--config", str(config), "bridge", "dispatch", "report", "--compact", "--json"],
+    )
+    assert result.exit_code == 0, result.output
+    return json.loads(result.output)
+
+
+def test_wi5257_compact_in_flight_uses_exact_launch_primary_and_numbered_work_item(tmp_path: Path) -> None:
+    root, config = _project(tmp_path)
+    _write_runtime(root)
+    _write_workflow_bridge(root, "live-thread", "NEW", work_item_id="WI-7001")
+    dispatch_id = _write_live_launch_state(root)
+    launch = {
+        "dispatch_id": dispatch_id,
+        "primary_bridge_id": "live-thread",
+        "document_lease_handles": [{"doc_slug": "other-thread"}, {"doc_slug": "live-thread"}],
+        "selected_documents": ["other-thread", "live-thread"],
+    }
+    _write_live_launch_state(root, launch_ledger={dispatch_id: launch})
+
+    record = _compact_payload(root, config)["in_flight"][0]
+
+    assert record["dispatch_id"] == dispatch_id
+    assert record["bridge_document"] == "live-thread"
+    assert record["work_item_id"] == "WI-7001"
+
+
+def test_wi5257_compact_in_flight_fails_closed_for_conflicting_or_unmatched_launches(tmp_path: Path) -> None:
+    root, config = _project(tmp_path)
+    _write_runtime(root)
+    dispatch_id = _write_live_launch_state(root)
+    first = {
+        "dispatch_id": dispatch_id,
+        "document_lease_handles": [{"doc_slug": "first-thread"}],
+    }
+    second = {
+        "dispatch_id": dispatch_id,
+        "document_lease_handles": [{"doc_slug": "second-thread"}],
+    }
+    _write_live_launch_state(root, launch_ledger={dispatch_id: first}, second_ledger={dispatch_id: second})
+
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] is None
+    assert record["work_item_id"] is None
+
+    unmatched = {**first, "dispatch_id": "different-dispatch"}
+    _write_live_launch_state(root, launch_ledger={"different-dispatch": unmatched}, second_ledger={})
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] is None
+    assert record["work_item_id"] is None
+
+
+def test_wi5257_compact_in_flight_uses_lease_then_selection_and_legacy_fallback(tmp_path: Path) -> None:
+    root, config = _project(tmp_path)
+    _write_runtime(root)
+    _write_workflow_bridge(root, "lease-first", "NEW", work_item_id="WI-7002")
+    dispatch_id = _write_live_launch_state(root)
+    launch = {
+        "dispatch_id": dispatch_id,
+        "primary_bridge_id": "unrelated-primary",
+        "document_lease_handles": [{"doc_slug": "lease-first"}],
+        "selected_documents": ["selected-second"],
+    }
+    _write_live_launch_state(root, launch_ledger={dispatch_id: launch})
+
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] == "lease-first"
+    assert record["work_item_id"] == "WI-7002"
+
+    legacy = {"dispatch_id": dispatch_id, "selected_documents": ["legacy-first", "legacy-second"]}
+    _write_workflow_bridge(root, "legacy-first", "NEW", work_item_id="WI-7003")
+    _write_live_launch_state(root, launch_ledger={}, last_launch=legacy)
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] == "legacy-first"
+    assert record["work_item_id"] == "WI-7003"
+
+
+def test_wi5257_compact_in_flight_rejects_malformed_slugs_and_does_not_infer_work_item(tmp_path: Path) -> None:
+    root, config = _project(tmp_path)
+    _write_runtime(root)
+    dispatch_id = _write_live_launch_state(root)
+    malformed = {
+        "dispatch_id": dispatch_id,
+        "primary_bridge_id": "../escape",
+        "document_lease_handles": [{"doc_slug": "live/thread"}],
+        "selected_documents": ["C:\\absolute", "", ".."],
+    }
+    _write_live_launch_state(root, launch_ledger={dispatch_id: malformed})
+
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] is None
+    assert record["work_item_id"] is None
+
+    _write_workflow_bridge(root, "thread-wi-7999", "NEW")
+    valid = {
+        "dispatch_id": dispatch_id,
+        "document_lease_handles": [{"doc_slug": "thread-wi-7999"}],
+    }
+    _write_live_launch_state(root, launch_ledger={dispatch_id: valid})
+    record = _compact_payload(root, config)["in_flight"][0]
+    assert record["bridge_document"] == "thread-wi-7999"
+    assert record["work_item_id"] is None
+
+
