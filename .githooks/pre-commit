#!/usr/bin/env bash
# Pre-commit hook: redacted secret scan plus PowerShell syntax validation.
# Delegates to .githooks/pre-commit-ps1-parse.ps1 when PS1 files are staged.
#
# Activation (one-time, per developer):
#   git config core.hooksPath .githooks
#
# Â© 2026 Remaker Digital, a DBA of VanDusen & Palmeter, LLC. All rights reserved.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
PYTHON_BIN="${PYTHON:-python}"

# Known synthetic findings are attested by exact line identity in
# config/governance/secret-scan-allowlist.toml (read from the index); a stale
# entry fails the scan. Candidate-high findings on any other line refuse the commit.
"$PYTHON_BIN" scripts/scan_secrets.py --staged || exit $?

# WI-3473: ruff format --check on staged Python (separate gate from ruff check).
# Stdlib-only script; resolves a ruff-capable interpreter venv-first so it does
# not fail open when PYTHON_BIN lacks ruff while the project venv has it.
"$PYTHON_BIN" scripts/check_ruff_format.py --staged || exit $?

# Inspect actual staged paths. Bridge messages, generated harness output and
# runtime state are not work product. The projector roots (.agent .claude .codex
# .cursor .goose .api-harness) are gitignored at the repository top level and
# refused here as postimages (owner ruling D14, 2026-09-17), so the ignore rule
# and the refusal state one policy; rendered output comes from `gt harness
# project`, never from a commit. config/governance/ carries no derived files: the
# timer inventory derives to .groundtruth/derived/, a non-product prefix refused
# as well. Deletions remain the route for retiring historical tracked copies;
# reviewed forward deletion stays possible.
"$PYTHON_BIN" scripts/check_commit_pathspec_safety.py --staged || exit $?

# Validate that staged baseline/projector sources can produce their projections.
# Installed projections are operational output and are not staged or committed.
"$PYTHON_BIN" scripts/check_projection_drift.py --staged || exit $?

# Native project finalization checks the complete independently reviewed product
# before commit and confirms the actual Git result afterward. These normal hooks
# check the candidate itself; they neither infer review from filenames nor create
# a second permission system. Direct owner commits use these same product checks.

# Only proceed if PowerShell is available
PWSH=""
if command -v pwsh &>/dev/null; then
    PWSH="pwsh"
elif command -v powershell.exe &>/dev/null; then
    PWSH="powershell.exe"
else
    # PowerShell not available (non-Windows environment) â€” skip gracefully
    exit 0
fi

# Only proceed if any staged files are .ps1
STAGED_PS1=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -c '\.ps1$' || true)
if [ "$STAGED_PS1" -eq 0 ]; then
    exit 0
fi

"$PWSH" -NoProfile -ExecutionPolicy Bypass \
    -File "$REPO_ROOT/.githooks/pre-commit-ps1-parse.ps1" || exit 1
